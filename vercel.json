{
  "version": 2,
  "rewrites": [
    {
      "source": "/oauth/(.*)",
      "destination": "https://206.189.130.216/oauth/$1"
    },
    {
      "source": "/application/(.*)",
      "destination": "https://206.189.130.216/application/$1"
    },

    {
      "source": "/auth/verify",
      "destination": "https://206.189.130.216/auth/verify"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
